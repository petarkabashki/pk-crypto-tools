% export PICATPATH=/media/mu6mula/Data/work/picat/Picat368/lib2:/media/mu6mula/Data/work/picat/Picat368/lib
% export PATH=$PATH:/media/mu6mula/Data/work/picat/Picat368
% cl('donchian').

main =>
    % Specify parameters for loading the data
    
    Exchange = "binance",
    Base = "BTC",
    Quote = "USDT",
    Timeframe = "4h",
    % Load the candlestick data
    OHLCV = transpose(list_matrix_to_array_matrix(load_candles(Exchange, Base, Quote, Timeframe, 1, 1000))),
    Len = len(OHLCV[1]),
    % printf("Loaded OHLCV %s / %s / %s / %s , Length: %d \n", Exchange, Base, Quote, Timeframe, Len),

    
    % Define the parameter for the Donchian Channels
    LBackP_Up = 95,
    LBackP_Dn = 28,
    LagP_Up = 16,
    LagP_Dn = 12,
    BandOffset = 0.8242584668754623,  % You can set this between 0 and 1

    Skip = max([LBackP_Up,LBackP_Dn,LagP_Up,LagP_Dn]),
    
    Highs = OHLCV[3],
    Lows = OHLCV[4],
    Closes = OHLCV[5],
    LogPrices = {log(Close) : Close in Closes},

    % Calculate the log returns
    LogRets = {LogPrices[I] - LogPrices[I-1] : I in 2..len(LogPrices)}++{0},

    DonchUp = shift_array(rolling_max(Highs, LBackP_Up), LagP_Up),
    DonchDn = shift_array(rolling_min(Lows, LBackP_Dn), LagP_Dn),
    MidBand = zeros_array(Skip) ++ {(1 - BandOffset) * DonchUp[I] + BandOffset * DonchDn[I] : I in Skip + 1..Len},

    LongEnterSignals = zeros_array(Skip) ++ {above(Closes[I], DonchUp[I]) : I in Skip+1..len(DonchUp)},
    LongExitSignals = zeros_array(Skip)  ++ {above(MidBand[I], Closes[I]) : I in Skip+1..len(MidBand)},

    ShortEnterSignals = zeros_array(Skip) ++ {above(DonchDn[I], Closes[I]) : I in Skip+1..len(DonchDn)},
    ShortExitSignals = zeros_array(Skip) ++ {above(Closes[I], MidBand[I]) : I in Skip+1..len(MidBand)},

    % printf("LongEnterSignals: %d\n", sum(LongEnterSignals)),
    % printf("ShortEnterSignals: %d\n", sum(ShortEnterSignals)),
    % printf("LongExitSignals: %d\n", sum(LongExitSignals)),
    % printf("ShortExitSignals: %d\n", sum(ShortExitSignals)),

    % Generate positions
    % LongPositions = populate_positions(LongEnterSignals, LongExitSignals, Skip),
    % ShortPositions = populate_positions(ShortEnterSignals, ShortExitSignals, Skip),
    LongPositions = zeros_array(Skip) ++ {LongEnterSignals[I] * (1 - LongExitSignals[I]) : I in Skip+1..Len},
    ShortPositions = zeros_array(Skip) ++ {ShortEnterSignals[I] * (1 - ShortExitSignals[I]) : I in Skip+1..Len},

    % printf("LongPositions: %w\n", [LongPositions[I]: I in Skip..Len]),
    % printf("ShortPositions: %w\n", [ShortPositions[I]: I in Skip..Len]),
    % Calculate returns for both long and short positions
    % LongRets = calculate_returns(LongPositions, LogReturns),
    % ShortRets = calculate_returns(ShortPositions, LogReturns),
    {LongTradeStarts,LongTradeEnds} = position_starts_ends(LongPositions, Len, Skip),
    printf("HAHAHA"),
    {ShortTradeStarts,ShortTradeEnds} = position_starts_ends(ShortPositions, Len, Skip),

    % LongTradeStarts = [I : I in Skip+1..Len, LongPositions[I] == 1, LongPositions[I-1] == 0],
    % LongTradeEnds = [I : I in Skip+1..Len-1, (LongPositions[I] == 0) , (LongPositions[I-1] == 1)] ++ cond(LongPositions[Len]==1, [1], []),
    % LongTradeRets = {LogPrices[LongTradeEnds[i]] - LogPrices[LongTradeStarts[I]] : I in 1..len(LongTradeStarts)},
    LongTradeRets = {LogPrices[TradeEnd] - LogPrices[TradeStart] : {TradeStart,TradeEnd} in zip(LongTradeStarts,LongTradeEnds)},
    ShortTradeRets = {LogPrices[TradeEnd] - LogPrices[TradeStart] : {TradeStart,TradeEnd} in zip(ShortTradeStarts,ShortTradeEnds)},
    LongTradeReturn = sum(LongTradeRets),
    ShortTradeReturn = sum(ShortTradeRets),
    % ShortTradeStarts = [I : I in Skip+1..Len, LongPositions[I] == 1, LongPositions[I-1] == 0],
    % ShortTradeEnds = [I : I in Skip+1..Len, LongPositions[I] == 1, LongPositions[I-1] == 0],
    writeln(LongTradeStarts),
    writeln(LongTradeStarts),
    writeln(len(LongTradeStarts)),
    
    writeln(LongTradeEnds),
    writeln(len(LongTradeEnds)),

    LongRets = zeros_array(Skip)++{LongPositions[I] * LogRets[I] : I in Skip+1..Len},
    ShortRets = zeros_array(Skip)++{ShortPositions[I] * LogRets[I] : I in Skip+1..Len},
    % printf("LongRets\n\t\t"),
    % writeln(LongRets),
    
    % Calculate total return by summing long and short returns,
    LongReturn = sum(LongRets),
    ShortReturn = sum(ShortRets),
    % printf("LongReturn: %f", LongReturn),
    TotalReturn = LongReturn + ShortReturn,
    CombinedReturns = {LongRets[I] + ShortRets[I] : I in 1..Len},

    % LongStartIndexes = cond(Len == 0, [], 
    %     cond(LongPositions[1] !== 0, [1], [])
    % ) ++ [I : I in 2..Len, (LongPositions[I] )],
    % LongStartIndexes = [I : I in 1..Len, ((LongPositions[I] !== 0), (I == 1 ; LongPositions[I-1] == 0))],
    % {LongStartIndexes, LongEndIndexes} = detect_sequences(LongRets),
    % {ShortStartIndexes, ShortEndIndexes} = detect_sequences(ShortRets),
    % printf("LongStartIndexes: %d\n", len(LongStartIndexes)),
    % printf("ShortStartIndexes: %d\n", len(ShortStartIndexes)),
    % printf("LongStartIndexes: %w\n", LondStartIndexes),
    % foreach (I in 1..len(LongStartIndexes))
    %     printf("%d,",LongStartIndexes[I])
    % end,

    % Output the results for verification
    % printf("LongPositions: %w\n", LongPositions),
    % printf("ShortPositions: %w\n", ShortPositions),
    % printf("LongRets: %w\n", LongRets),
    % printf("ShortRets: %w\n", ShortRets),
    % printf("CombinedReturns: %w\n", CombinedReturns),
    printf("LongReturn: %f\n", LongReturn),
    printf("LongTradeReturn: %f\n", LongTradeReturn),
    printf("ShortReturn: %f\n", ShortReturn),
    printf("ShortTradeReturn: %f\n", ShortTradeReturn),
    printf("TotalReturn: %f\n", TotalReturn)
    .

position_starts_ends(Positions, Len, Skip) = {PositionStarts, PositionEnds} =>
    PositionStarts = [I : I in Skip+1..Len, Positions[I] == 1, Positions[I-1] == 0],
    PositionEnds = [I : I in Skip+1..Len-1, (Positions[I] == 0) , (Positions[I-1] == 1)] ++ cond(Positions[Len]==1, [1], [])
.

zeros_array(Len) = Result =>
    Result = new_array(Len),
    foreach (I in 1..Len)
        Result[I] = 0
    end.


% Function to load candlestick data
load_candles(Exchange, Base, Quote, Timeframe, From, To) = Candles =>
% load_candles(Base) = Candles =>
    % Construct the file name
    FileName = "/media/mu6mula/Data/Crypto-Data-Feed/freq-user-data/data/" ++ Exchange ++ "/" ++ Base ++ "_" ++ Quote ++ "-" ++ Timeframe ++ ".json",
    S = read_file_chars(FileName),
    AllCandles = json_decode(S),
    Len = len(AllCandles),
    Candles = [AllCandles[I] : I in From..min([To,Len])]
    .

% Predicate to calculate the upper band of Donchian Channels with lagging
% calculate_upper_band(Highs, LBackP_Up, Lag) = DonchUp =>
%     RollingMax = rolling_max(Highs, LBackP_Up),
%     LaggedRollingMax = lag_list(RollingMax, Lag),
%     DonchUp = pad_list(LaggedRollingMax, len(Highs), 0).

% % Predicate to calculate the lower band of Donchian Channels with lagging
% calculate_lower_band(LowPrices, LBackP_Up, Lag) = DonchDn =>
%     RollingMin = rolling_min(LowPrices, LBackP_Up),
%     LaggedRollingMin = lag_list(RollingMin, Lag),
%     DonchDn = pad_list(LaggedRollingMin, len(LowPrices), 0).

% Function to calculate the rolling maximum over a specified period with zero padding
rolling_max(Array, Period) = ResultArray =>
    Len = len(Array),
    
    % Ensure the array is long enough for the period
    if Period =< Len then
        ResultArray = new_array(Len),
        foreach (I in 1..Period-1)
            ResultArray[I] = 0
        end,
        % Calculate the rolling max for the valid range
        foreach (I in Period..Len)
            % Determine the maximum in the current window
            MaxValue = max([Array[J] : J in I-Period+1..I]),
            % Assign the maximum value to the current position in the result array
            ResultArray[I] = MaxValue
        end
    else
        ResultArray = new_array(Len,0)
    end.

rolling_min(Array, Period) = ResultArray =>
    Len = len(Array),
    
    % Ensure the array is long enough for the period
    if Period =< Len then
        ResultArray = new_array(Len),
        foreach (I in 1..Period-1)
            ResultArray[I] = 0
        end,
        % Calculate the rolling max for the valid range
        foreach (I in Period..Len)
            % Determine the maximum in the current window
            MaxValue = min([Array[J] : J in I-Period+1..I]),
            % Assign the maximum value to the current position in the result array
            ResultArray[I] = MaxValue
        end
    else
        ResultArray = new_array(Len,0)
    end.


% Function to lag a list by a specified number of periods
shift_array(List, Lag) = LaggedList =>
    Padding = new_array(Lag),
    foreach (I in 1..Lag) Padding[I] = 0 end,
    LaggedList = Padding ++ List[1..len(List)-Lag].

% Function to generate a signal based on a condition
above(Value1, Value2) = cond(Value1 > Value2, 1, 0).
% above(Value1, Value2) = F, Value1 <= Value2 => F = 0.

